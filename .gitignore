# Python
__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/

# Generated output. `out/` is where the tool writes previews, caches, exported
# boards and the draft library, so it must never be committed.
out/

# Board files are user work and can be large. The one exception is the captured
# fixture the unit tests parse.
*.epro2
*.epru
!tests/fixtures/*.epru
# The two authored blank templates are application resources, not user work.
!assets/通行证模板源文件/模板-精0、精1、皮肤小.epro2
!assets/通行证模板源文件/模板-精2、皮肤大.epro2
# Full mirrors and retired illustration libraries are still external assets.
assets/明日方舟/
assets/明日方舟-通行证素材*/

# Machine-readable calibration report, regenerated by tools/m0_calibrate.py.
docs/m0_calibration.json

# ⚠️ Machine-local notes: absolute paths on this developer's drives, private
# organisation names, and the CNB token's operational recipe. The project went
# to shared development on 2026-10-09, and AGENTS.md is tracked -- keeping this
# content there would ship one machine's directory layout to every collaborator.
AGENTS.local.md

# The clean copy prepared for GitHub is its own repository. Without this the
# outer repo would see it as an untracked embedded repo and `git add -A` would
# record a bare gitlink instead of files.
推GitHub/

# Build artefacts
build/
dist/

# Editors
.idea/
.vscode/
*.swp
